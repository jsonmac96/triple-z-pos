# Copy to .env (or set these in your hosting environment)
NODE_ENV=production
PORT=3000
# REQUIRED in production: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=change-me
# Path of the SQLite database file
DB_FILE=./data/triplez.db
# Set to 1 when running behind an HTTPS reverse proxy (nginx, Caddy, Render, etc.)
TRUST_PROXY=0
# Set to 0 only for local testing over plain http:// in production mode
COOKIE_SECURE=1
