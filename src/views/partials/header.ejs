<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Triple Z POS</title>
  <link rel="stylesheet" href="/static/css/app.css">
<%- include('head-icons') %>
</head>
<body>
<% if (ephemeralStorage) { %>
<div class="storage-warning" role="alert">
  &#9888; Data is NOT being saved permanently. Orders, sales and password changes will be erased the next time the app is updated or restarts.
  Ask the admin to attach a Railway volume (mount path <code>/data</code>).
</div>
<% } %>
<% const signedIn = currentUser && !currentUser.must_change_password; %>
<% if (signedIn) { %>
<header class="topbar">
  <a class="brand" href="/"><img src="/static/img/logo-mark.svg" alt="" width="30" height="30"> Triple Z <span>POS</span></a>
  <nav>
    <% const tab = function (href, label, match) { const on = match ? match() : currentPath === href; %>
      <a href="<%= href %>" class="<%= on ? 'active' : '' %>"><%= label %></a>
    <% }; %>
    <% tab('/', 'Dashboard'); %>
    <% tab('/orders', 'Orders', function () { return currentPath.startsWith('/orders') && currentPath !== '/orders/new'; }); %>
    <% tab('/orders/new', '+ New order'); %>
    <% tab('/collections', 'Collections', function () { return currentPath.startsWith('/collections'); }); %>
    <% tab('/customers', 'Customers', function () { return currentPath.startsWith('/customers'); }); %>
    <% tab('/catalog', 'Services & Items', function () { return currentPath.startsWith('/catalog'); }); %>
    <% tab('/inventory', 'Inventory', function () { return currentPath.startsWith('/inventory'); }); %>
    <% tab('/sales', 'Sales', function () { return currentPath.startsWith('/sales'); }); %>
    <% tab('/settings', 'Settings', function () { return currentPath.startsWith('/settings'); }); %>
  </nav>
  <div class="user">
    <a href="/orders?status=open&amp;urgency=overdue" class="bell" id="alert-bell" title="Overdue and urgent orders">
      &#128276; <span class="bell-count" id="alert-count" hidden>0</span>
    </a>
    <button type="button" class="link" id="enable-notify" hidden>Enable alerts</button>
    <span class="who"><%= currentUser.display_name %></span>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Log out</button>
    </form>
  </div>
</header>
<% } %>
<main class="<%= signedIn ? '' : 'narrow' %>">
<% if (flash) { %><div class="flash" role="status"><%= flash %></div><% } %>
<% if (flashError) { %><div class="flash flash-error" role="alert"><%= flashError %></div><% } %>
