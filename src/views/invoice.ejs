<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Triple Z Printing</title>
  <link rel="stylesheet" href="/static/css/print.css">
  <link rel="stylesheet" href="/static/css/paper/<%= paper.key %>.css" id="paper-css">
<%- include('partials/head-icons') %>
</head>
<% const statusText = order.status === 'cancelled' ? 'CANCELLED' : order.balance_cents <= 0 ? 'PAID' : order.paid_cents > 0 ? 'PARTIALLY PAID' : 'UNPAID'; %>
<body class="paper-<%= paper.key %> kind-<%= paper.kind %>" data-paper-width="<%= paper.width %>">
<% if (ephemeralStorage) { %>
<div class="storage-warning no-print" role="alert">
  &#9888; Data is NOT being saved permanently. Orders, sales and password changes will be erased the next time the app is updated or restarts.
  Ask the admin to attach a Railway volume (mount path <code>/data</code>).
</div>
<% } %>
  <div class="toolbar no-print">
    <a href="/orders/<%= order.id %>">&larr; Back to order</a>
    <form method="get" action="/orders/<%= order.id %>/invoice" class="paper-form" id="paper-form">
      <label for="paper-select">Paper</label>
      <select name="paper" id="paper-select">
        <% Object.keys(KIND_LABELS).forEach(function (kind) { %>
          <optgroup label="<%= KIND_LABELS[kind] %>">
            <% Object.keys(PAPERS).filter(function (k) { return PAPERS[k].kind === kind; }).forEach(function (k) { %>
              <option value="<%= k %>" <%= k === paper.key ? 'selected' : '' %>><%= PAPERS[k].label %></option>
            <% }) %>
          </optgroup>
        <% }) %>
      </select>
      <button type="submit" class="secondary" id="paper-apply">Apply</button>
    </form>
    <button type="button" id="print-btn">&#128424; Print invoice</button>
  </div>
  <p class="print-hint no-print">
    In the print dialog choose paper size <strong><%= paper.label %></strong>, Margins: <strong><%= paper.kind === 'receipt' ? 'None' : 'Default' %></strong>, Scale: <strong>100%</strong>.
    <% if (paper.kind === 'receipt') { %>Select your receipt printer as the destination.<% } %>
  </p>

<% if (paper.kind === 'receipt') { %>
  <article class="invoice receipt">
    <header>
      <img src="/static/img/logo-mark.svg" alt="" width="40" height="40">
      <h1>Triple Z Printing</h1>
      <p>INVOICE <strong><%= order.order_no %></strong></p>
      <p>Date: <%= fmt.dateOnly(order.created_at) %></p>
      <p>Pickup: <%= fmt.dateTime(order.deadline_at) %></p>
    </header>
    <section class="r-customer">
      <p><strong><%= order.customer_name %></strong></p>
      <% if (order.customer_phone) { %><p><%= order.customer_phone %></p><% } %>
      <% if (order.description) { %><p class="desc"><%= order.description %></p><% } %>
    </section>
    <ul class="r-items">
      <% order.items.forEach(function (it) { %>
        <li>
          <div class="r-name"><%= it.item %></div>
          <div class="r-line"><span><%= it.qty %> × <%= fmt.peso(it.unit_price_cents) %></span><span><%= fmt.peso(it.qty * it.unit_price_cents) %></span></div>
        </li>
      <% }) %>
    </ul>
    <div class="r-totals">
      <div class="r-line r-total"><span>TOTAL</span><span><%= fmt.peso(order.total_cents) %></span></div>
      <% order.payments.forEach(function (p) { %>
        <div class="r-line"><span>Paid <%= fmt.dateOnly(p.paid_at) %> <%= METHOD_LABELS[p.method] %></span><span>−<%= fmt.peso(p.amount_cents) %></span></div>
      <% }) %>
      <div class="r-line r-balance"><span>BALANCE</span><span><%= fmt.peso(order.balance_cents) %></span></div>
    </div>
    <p class="r-status"><%= statusText %></p>
    <footer>
      <p>Thank you for choosing Triple Z Printing!</p>
      <p class="small">Printed <%= fmt.dateTime(printedAt) %> by <%= currentUser.display_name %></p>
    </footer>
  </article>
<% } else { %>
  <article class="invoice">
    <header>
      <div class="shop">
        <img src="/static/img/logo-mark.svg" alt="" width="56" height="56">
        <div>
          <h1>Triple Z Printing</h1>
          <p class="muted">Printing services</p>
        </div>
      </div>
      <div class="meta">
        <h2>INVOICE</h2>
        <p><strong><%= order.order_no %></strong></p>
        <p>Date: <%= fmt.dateOnly(order.created_at) %></p>
        <p>Due / pickup: <%= fmt.dateTime(order.deadline_at) %></p>
      </div>
    </header>
    <section class="bill-to">
      <h3>Bill to</h3>
      <p><strong><%= order.customer_name %></strong></p>
      <% if (order.customer_phone) { %><p><%= order.customer_phone %></p><% } %>
      <% if (order.customer_email) { %><p><%= order.customer_email %></p><% } %>
      <% if (order.description) { %><p class="desc"><%= order.description %></p><% } %>
    </section>
    <table>
      <thead><tr><th>#</th><th>Item</th><th class="num">Qty</th><th class="num">Unit price</th><th class="num">Amount</th></tr></thead>
      <tbody>
      <% order.items.forEach(function (it, i) { %>
        <tr><td><%= i + 1 %></td><td><%= it.item %></td><td class="num"><%= it.qty %></td><td class="num"><%= fmt.peso(it.unit_price_cents) %></td><td class="num"><%= fmt.peso(it.qty * it.unit_price_cents) %></td></tr>
      <% }) %>
      </tbody>
    </table>
    <table class="totals">
      <tr><th>Total</th><td class="num"><%= fmt.peso(order.total_cents) %></td></tr>
      <% order.payments.forEach(function (p) { %>
        <tr class="muted"><th>Paid <%= fmt.dateOnly(p.paid_at) %> (<%= METHOD_LABELS[p.method] %>)</th><td class="num">−<%= fmt.peso(p.amount_cents) %></td></tr>
      <% }) %>
      <tr class="balance"><th>Balance due</th><td class="num"><%= fmt.peso(order.balance_cents) %></td></tr>
    </table>
    <p class="status">Status: <strong><%= statusText %></strong></p>
    <footer>
      <p>Thank you for choosing Triple Z Printing!</p>
      <p class="muted small">Printed <%= fmt.dateTime(printedAt) %> by <%= currentUser.display_name %></p>
    </footer>
  </article>
<% } %>
  <script src="/static/js/invoice.js" defer></script>
</body>
</html>
