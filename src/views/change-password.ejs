<%- include('partials/header') %>
<section class="card login">
  <img class="login-logo small" src="/static/img/logo.svg" alt="Triple Z Printing" width="300" height="64">
  <h1>Change password</h1>
  <% if (currentUser.must_change_password) { %>
    <p class="muted">Hi <%= currentUser.display_name %>, you are using a temporary password. Please set your own before continuing.</p>
  <% } %>
  <%- include('partials/errors', { errors }) %>
  <form method="post" action="/change-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Current password <input type="password" name="current_password" maxlength="200" required autocomplete="current-password"></label>
    <label>New password <input type="password" name="new_password" minlength="10" maxlength="128" required autocomplete="new-password"></label>
    <label>Confirm new password <input type="password" name="confirm_password" minlength="10" maxlength="128" required autocomplete="new-password"></label>
    <p class="hint">At least 10 characters with uppercase, lowercase, a number and a symbol.</p>
    <button type="submit" class="primary">Save password</button>
  </form>
  <form method="post" action="/logout" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button type="submit" class="link">Log out</button>
  </form>
</section>
<%- include('partials/footer') %>
