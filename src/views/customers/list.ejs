<%- include('../partials/header') %>
<div class="page-head">
  <h1>Customers</h1>
  <a class="button primary" href="/customers/new">+ Add customer</a>
</div>
<form method="get" action="/customers" class="filters card">
  <input type="search" name="q" value="<%= q %>" maxlength="100" placeholder="Search name, phone or email">
  <button type="submit">Search</button>
  <% if (q) { %><a href="/customers">Clear</a><% } %>
</form>
<section class="card">
  <p class="muted small">Customers are saved automatically when you create an order. Repeat clients are matched by phone number (or by name when there's no phone).</p>
  <% if (!customers.length) { %><p class="muted">No customers yet.</p><% } else { %>
  <div class="table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Phone</th><th class="num">Orders</th><th>Last order</th><th class="num">Total paid</th><th class="num">Balance</th></tr></thead>
    <tbody>
    <% customers.forEach(function (c) { %>
      <tr>
        <td><a href="/customers/<%= c.id %>"><strong><%= c.name %></strong></a><% if (c.order_count > 1) { %> <span class="badge repeat">Repeat</span><% } %>
          <% if (c.email) { %><div class="muted small"><%= c.email %></div><% } %></td>
        <td><%= c.phone %></td>
        <td class="num"><%= c.order_count %></td>
        <td><%= c.last_order_at ? fmt.dateOnly(c.last_order_at) : '—' %></td>
        <td class="num"><%= fmt.peso(c.paid_cents) %></td>
        <td class="num <%= c.balance_cents > 0 ? 'owed' : '' %>"><%= fmt.peso(c.balance_cents) %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
